@model EditProfileViewModel

<div class="edit-profile-form-container">
    <div class="edit-profile-form-width">
        <div class="edit-profile-wrapper">
            <div class="edit-profile-container">
                <div class="edit-profile-header">
                    <h1 class="edit-profile-title">Edit Profile</h1>
                    <p class="edit-profile-subtitle">Update your personal information</p>
                </div>

                <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                    <div class="edit-profile-form-group">
                        <label asp-for="DisplayName" class="edit-profile-label">Display Name</label>
                        <span asp-validation-for="DisplayName" class="error-Message"></span>
                        <input type="text" name="DisplayName" class="edit-profile-input" placeholder="Choose a display name">
                    </div>

                    <div class="edit-profile-form-group">
                        <label asp-for="Bio" class="edit-profile-label">Bio</label>
                        <span asp-validation-for="Bio" class="error-Message"></span>
                        <input type="text" name="Bio" class="edit-profile-input" placeholder="Tell us about yourself">
                    </div>

                    <div class="edit-profile-form-group">
                        <label asp-for="Location" class="edit-profile-label">Location</label>
                        <span asp-validation-for="Location" class="error-Message"></span>
                        <input type="text" name="Location" class="edit-profile-input" placeholder="Where are you located?">
                    </div>

                    <div class="edit-profile-form-group">
                        <label class="edit-profile-label">Choose Profile Picture</label>
                        <input type="file" accept=".png, .jpg, .jpeg" name="ProfilePictureUrl" class="edit-profile-input">
                    </div>

                    <button type="submit" class="edit-profile-submit-btn">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>