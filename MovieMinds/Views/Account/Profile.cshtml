                                <img src="https://image.tmdb.org/t/p/original/@movie.PosterPath" alt="@movie.Title" />
                                <div class="movie-overlay"></div>
                                <div class="movie-rating">@(movie.TmdbRating!.Value.ToString("0.0") ?? "N/A")</div>
                                <div class="movie-info">
                                    <div class="movie-year">@(movie.ReleaseDate?.Substring(0, 4) ?? "N/A")</div>
                                </div>
                            </div>
                            <h3 class="movie-title serif">@movie.Title</h3>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                No watched movies yet
            </div>
        }
    </div>

    <div class="section">
        <div class="section-header">
            <h2 class="section-title">Watchlist</h2>
            <a href="#" class="view-all">ALL</a>
        </div>
        @if (Model.InWatchList.Any())
        {
            <div class="action-display-container">
                @foreach (var movie in Model.InWatchList)
                {
                    <div class="movie-card">
                        <a class="movie-details" asp-controller="MovieDetails" asp-action="Details" asp-route-id="@movie.Id">
                            <div class="movie-poster">
                                <img src="https://image.tmdb.org/t/p/original/@movie.PosterPath" alt="@movie.Title" />
                                <div class="movie-overlay"></div>
                                <div class="movie-rating">@(movie.TmdbRating!.Value.ToString("0.0") ?? "N/A")</div>
                                <div class="movie-info">
                                    <div class="movie-year">@(movie.ReleaseDate?.Substring(0, 4) ?? "N/A")</div>
                                </div>
                            </div>
                            <h3 class="movie-title serif">@movie.Title</h3>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                No movies in watch-list yet
            </div>
        }
    </div>

    <div class="section">
        <div class="section-header">
            <h2 class="section-title">Reviews</h2>
            <a href="#" class="view-all">ALL</a>
        </div>
        @if (Model.Reviewed.Any())
